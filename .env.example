# 复制为 .env 后按实际环境修改：Copy-Item .env.example .env
# docker compose 会自动读取根目录的 .env。以下值仅用于本地演示，生产必须全部替换。

# MySQL root 密码
DB_ROOT_PWD=root123

# MySQL 应用账号（railway）密码
DB_USER_PWD=railway123

# JWT 签名密钥：HS256 要求至少 32 字节，请生成随机字符串并妥善保管
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# 跨域来源白名单：同源 / Nginx 反代部署保持 *；
# 前后端分域名部署时填前端来源（多个用逗号分隔，支持通配符，如 https://*.example.com）
APP_CORS_ALLOWED_ORIGINS=*

# Redis 密码：Compose 内的 Redis 服务与后端共用，生产必须替换
REDIS_PWD=railway_redis_123

# 宿主机 Redis 映射端口（本机已装 Redis 时可改为 6380，容器内始终是 6379）
REDIS_HOST_PORT=6379

# 缓存实现：redis（Compose 默认）/ caffeine（无 Redis 时回退）/ none
SPRING_CACHE_TYPE=redis

# 是否把 Redis 纳入 /actuator/health 健康检查（Compose 默认开启）
REDIS_HEALTH_ENABLED=true

# RabbitMQ：订单事件即时通道（Compose 默认启用；关掉则 worker 轮询发件箱兜底）
ORDER_MQ_ENABLED=true
RABBITMQ_USER=railway
RABBITMQ_PWD=railway_rabbit_123
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# prod 启动会强制校验 JWT_SECRET / SPRING_DATASOURCE_PASSWORD（Redis 模式下还有
# SPRING_DATA_REDIS_PASSWORD）由环境变量显式提供；本地模拟 prod 可设 APP_REQUIRE_STRONG_SECRETS=false

# AI 助手（可选）：模型密钥只保存在服务端，不写入浏览器。
# 不配置 AI_API_KEY 时 AI 助手自动降级为模拟回复，不影响其它功能。
# AI_API_KEY=sk-your-deepseek-or-openai-compatible-key
# AI_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# AI_MODEL=deepseek-chat
# AI_TEMPERATURE=0.7

# 日志归档（prod 生效）：目录、保留天数、单文件大小、总大小上限
# LOG_DIR=logs
# LOG_RETAIN_DAYS=30
# LOG_MAX_SIZE=100MB
# LOG_TOTAL_SIZE=3GB

# 链路追踪（默认开启，仅写日志 traceId，不上报）
# TRACING_ENABLED=true
# TRACING_SAMPLING_PROBABILITY=1.0
# 需要 Zipkin 可视化时：docker compose --profile tracing up -d，并取消下面这行注释
# ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
# ZIPKIN_CONNECT_TIMEOUT=1s
# ZIPKIN_READ_TIMEOUT=1s
