# 复制为 .env 后按实际环境修改：Copy-Item .env.example .env
# docker compose 会自动读取根目录的 .env。以下值仅用于本地演示，生产必须全部替换。

# MySQL root 密码
DB_ROOT_PWD=root123

# MySQL 应用账号（railway）密码
DB_USER_PWD=railway123

# JWT 签名密钥：HS256 要求至少 32 字节，请生成随机字符串并妥善保管
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# 跨域来源白名单：同源 / Nginx 反代部署保持 *；
# 前后端分域名部署时填前端来源（多个用逗号分隔，支持通配符，如 https://*.example.com）
APP_CORS_ALLOWED_ORIGINS=*
