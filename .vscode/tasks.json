{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "后端: 打包 (跳过测试)",
      "type": "shell",
      "command": ".\\mvnw.cmd clean package -DskipTests",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "前端: 安装依赖",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "前端: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "前端: 构建",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
