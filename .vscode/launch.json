{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "后端: Spring Boot (dev)",
      "request": "launch",
      "mainClass": "com.example.demo.Demo2Application",
      "args": "",
      "env": {
        "SPRING_PROFILES_ACTIVE": "dev"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node-terminal",
      "name": "前端: Vite dev server",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "全栈: 后端 + 前端",
      "configurations": [
        "后端: Spring Boot (dev)",
        "前端: Vite dev server"
      ],
      "stopAll": true
    }
  ]
}
